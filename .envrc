#!/usr/bin/env bash

# Auto-activate the dev shell on `cd` (requires direnv + its shell hook, then a
# one-time `direnv allow`). Without this, entering the project directory leaves
# you in the ambient shell — Homebrew and /usr/bin ahead of nix on PATH — and
# every command has to be wrapped in `nix develop` by hand.
#
# `--no-pure-eval` is not optional: devenv reads the working directory, which
# pure evaluation forbids. `nix develop` and `nix flake check` need the same
# flag, which is why the CI workflow carries it too.

if ! has nix_direnv_version || ! nix_direnv_version 3.1.0; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.1.0/direnvrc" "sha256-yMJ2OVMzrFaDPn7q8nCBZFRYpL/f0RcHzhmw/i6btJM="
fi

export DEVENV_IN_DIRENV_SHELL=true

watch_file devenv.nix
watch_file flake.nix
watch_file flake.lock
if ! use flake . --no-pure-eval; then
  echo "devenv could not be built. The devenv environment was not loaded. Make the necessary changes to devenv.nix and hit enter to try again." >&2
fi
